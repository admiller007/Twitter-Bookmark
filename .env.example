# X Bookmark Vault - optional build-time configuration
#
# Copy to .env if you want to change the defaults baked into a build:
#
#   cp .env.example .env
#
# Everything here is optional. The extension works with no .env file at all.

# Default JEV (TypeSafe System One) endpoint shown in Settings.
# VITE_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Default JEV model id.
# VITE_JEV_MODEL=jev-latest

# ---------------------------------------------------------------------------
# There is deliberately NO VITE_JEV_API_KEY.
#
# Anything prefixed with VITE_ is inlined into the built JavaScript, so a key
# set here would ship inside the extension and be readable by anyone who has
# it. Enter your key in the extension's Settings screen instead; it is stored
# with chrome.storage.local, scoped to your browser profile, and is never
# written into the bookmark database, exports, backups or diagnostics.
# ---------------------------------------------------------------------------
